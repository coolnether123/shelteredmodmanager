{
  "schemaVersion": 2,
  "name": "Sheltered 2.0 incremental release graph",
  "description": "Change-to-gate mapping for the exact eleven-package wave. The graph is declarative; the PowerShell runner owns execution and JSON reporting.",
  "defaults": {
    "configuration": "Release",
    "platforms": [ "Steam", "Epic" ],
    "managerRepo": "shelteredmodmanager",
    "packageScript": "release/2.0/tools/New-ModPackages.ps1",
    "managerPackageScript": "shelteredmodmanager/tools/New-ReleasePackages.ps1",
    "runtimeSharedModDirectories": [ "ModAPI", "PluginHarmony", "PluginInitializer" ],
    "harnessSharedInputs": [ "ShelteredAgentInterface/Core/AgentInterfacePlugin.cs", "ShelteredAgentInterface/Http/AgentHttpServer.cs", "ShelteredAgentInterface/Http/JsonUtil.cs" ]
  },
  "sharedRules": [
    {
      "id": "documentation",
      "patterns": [ "README*", "**/*.md", "**/*.txt", "**/docs/**", "**/documentation/**" ],
      "effects": [ "documentation-only" ]
    },
    {
      "id": "test-only",
      "patterns": [ "**/*Tests.cs", "**/*Tests.csproj", "**/tests/**", "**/test/**", "**/Test-*.ps1" ],
      "effects": [ "contracts-only" ]
    },
    {
      "id": "source",
      "patterns": [ "**/*.cs", "**/*.csproj", "**/*.props", "**/*.targets", "**/*.sln", "**/*.config", "**/packages.config" ],
      "effects": [ "build", "contracts", "gameplay", "platform-smoke", "package", "promotion" ]
    },
    {
      "id": "runtime-data",
      "patterns": [ "**/About/**", "**/Config/**", "**/Assets/**", "**/*.json", "**/*.xml", "**/*.png", "**/*.shader" ],
      "effects": [ "build", "contracts", "gameplay", "platform-smoke", "package", "promotion" ]
    },
    {
      "id": "release-tooling",
      "patterns": [ "shelteredmodmanager/tools/release-orchestration/**" ],
      "effects": [ "release-graph" ]
    },
    {
      "id": "release-packages",
      "patterns": [ "release/2.0/release-manifest.json", "release/2.0/*.csv" ],
      "effects": [ "release-packages" ]
    }
  ],
  "repositories": [
    { "id": "ExpeditionFour", "path": "ExpeditionFour", "runtimeModDirectories": [ "Four Person Expeditions" ], "project": "ExpeditionFour/ExpeditionFour/ExpeditionFour.csproj", "scenarios": [ "four-person-expedition" ], "contracts": [ "ExpeditionFour/tests/Test-OnShowFreshPartyRecovery.ps1" ], "package": true },
    { "id": "TradingAmount", "path": "TradingAmount", "runtimeModDirectories": [ "Trading Amount" ], "project": "TradingAmount/TradingAmount/TradingAmount.csproj", "scenarios": [ "trading-amount" ], "scenarioRules": [ { "patterns": [ "**/TradingAmountPatches.cs", "**/TradingAmountPlugin.cs" ], "scenarios": [ "trading-amount" ] } ], "contracts": [], "package": true },
    { "id": "Better-AI-Queue", "path": "Better-AI-Queue", "runtimeModDirectories": [ "Better AI Queue" ], "project": "Better-AI-Queue/Better AI Queue/Better AI Queue.csproj", "scenarios": [ "better-ai-queue-persistence" ], "contracts": [], "package": true },
    { "id": "Lifespan", "path": "Lifespan", "runtimeModDirectories": [ "Lifespan" ], "project": "Lifespan/Lifespan/Lifespan.csproj", "contractProjects": [ "Lifespan/Lifespan.Tests/Lifespan.Tests.csproj" ], "scenarios": [ "lifespan-persistence" ], "contracts": [], "package": true },
    { "id": "BunkerRandomLocation", "path": "BunkerRandomLocation", "runtimeModDirectories": [ "Bunker Random Location" ], "project": "BunkerRandomLocation/BunkerRandomLocation/BunkerRandomLocation.csproj", "scenarios": [ "bunker-persistence" ], "contracts": [], "package": true },
    { "id": "Procreation-Framework", "path": "Procreation-Framework", "runtimeModDirectories": [ "Family Expansion" ], "project": "Procreation-Framework/Procreation Framework/Procreation Framework.csproj", "contractProjects": [ "Procreation-Framework/ProcreationFramework.Tests/ProcreationFramework.Tests.csproj" ], "scenarios": [ "family-persistence" ], "contracts": [], "package": true },
    { "id": "Deep-Expansion", "path": "Deep-Expansion", "runtimeModDirectories": [ "Deep Expansion" ], "project": "Deep-Expansion/Deep Expansion/Deep Expansion.csproj", "scenarios": [ "deep-progression" ], "contracts": [ "Deep-Expansion/tests/Test-DepthResearchReadinessContract.ps1" ], "package": true },
    {
      "id": "Sheltered-Vanilla-Fixes", "path": "Sheltered-Vanilla-Fixes", "runtimeModDirectories": [ "Sheltered Vanilla Fixes" ], "project": "Sheltered-Vanilla-Fixes/Sheltered Vanilla Fixes/Sheltered Vanilla Fixes.csproj",
      "scenarios": [ "vanilla-breach", "vanilla-radio", "vanilla-quest-weapons", "vanilla-trading-slots", "vanilla-weapon-craft", "vanilla-recycling" ],
      "scenarioRules": [
        { "patterns": [ "**/*Breach*", "**/CapacityMutation.cs" ], "scenarios": [ "vanilla-breach" ] },
        { "patterns": [ "**/*Radio*" ], "scenarios": [ "vanilla-radio" ] },
        { "patterns": [ "**/*QuestNpcWeapon*" ], "scenarios": [ "vanilla-quest-weapons" ] },
        { "patterns": [ "**/*TradingWhiteSlot*" ], "scenarios": [ "vanilla-trading-slots", "trading-amount" ] },
        { "patterns": [ "**/*WeaponCraft*" ], "scenarios": [ "vanilla-weapon-craft" ] },
        { "patterns": [ "**/*Recycling*" ], "scenarios": [ "vanilla-recycling" ] }
      ],
      "contracts": [ "Sheltered-Vanilla-Fixes/Tests/Validate-NonGame.ps1" ], "package": true
    },
    {
      "id": "Shelter-Systems-Expansion", "path": "Shelter-Systems-Expansion", "runtimeModDirectories": [ "Shelter Systems Expansion" ], "project": "Shelter-Systems-Expansion/Shelter Systems Expansion/Shelter Systems Expansion.csproj",
      "scenarios": [ "systems-oxygen", "systems-water" ],
      "scenarioRules": [
        { "patterns": [ "**/*Oxygen*", "**/FireManagerPatch.cs", "**/EnvironmentManagerPatch.cs" ], "scenarios": [ "systems-oxygen" ] },
        { "patterns": [ "**/*Water*" ], "scenarios": [ "systems-water" ] }
      ],
      "contracts": [], "package": true
    },
    { "id": "Sheltered-Expanded-Map-Sizes", "path": "Sheltered-Expanded-Map-Sizes", "runtimeModDirectories": [ "Expanded Map Sizes" ], "project": "Sheltered-Expanded-Map-Sizes/ExpandedMapSizes/ExpandedMapSizes.csproj", "contractProjects": [ "Sheltered-Expanded-Map-Sizes/ExpandedMapSizes.Tests/ExpandedMapSizes.Tests.csproj" ], "scenarios": [ "expanded-map-sizes" ], "contracts": [], "package": true },
    { "id": "Sheltered-Display-Fixes", "path": "Sheltered-Display-Fixes", "runtimeModDirectories": [ "Sheltered Display Fixes" ], "project": "Sheltered-Display-Fixes/Sheltered Display Fixes/Sheltered Display Fixes.csproj", "scenarios": [ "display-fixes" ], "contracts": [], "package": true }
  ],
  "manager": {
    "id": "shelteredmodmanager",
    "path": "shelteredmodmanager",
    "solution": "shelteredmodmanager/ShelteredModManager.sln",
    "contracts": [
      "shelteredmodmanager/tools/Test-NexusManagerContracts.ps1",
      "shelteredmodmanager/tools/Test-NexusOAuthContracts.ps1",
      "shelteredmodmanager/tools/Test-NexusHttpBehavior.ps1",
      "shelteredmodmanager/tools/Test-ManagerSelfUpdate.ps1",
      "shelteredmodmanager/tools/Test-SaveBackupSafety.ps1",
      "shelteredmodmanager/tools/Test-SaveRestoreCrashSafety.ps1",
      "shelteredmodmanager/tools/Test-SavePagingVanillaRefreshContracts.ps1",
      "shelteredmodmanager/tools/Test-ShelteredApiContracts.ps1",
      "shelteredmodmanager/tools/Verify-ModApiBoundary.ps1",
      "shelteredmodmanager/tools/Verify-ShelteredApiPublicSurface.ps1",
      "shelteredmodmanager/tools/Test-ShelteredScenarioEditorContracts.ps1",
      "shelteredmodmanager/tools/Test-ScenarioEditorAssemblyBoundary.ps1"
    ],
    "platformSmoke": [ "manager-platform-smoke" ],
    "package": true,
    "promotion": [ "manager-rc", "manager-stable-live" ]
  },
  "dependencyEdges": [
    { "provider": "Lifespan", "consumer": "Procreation-Framework", "scenario": "family-persistence", "reason": "Family Expansion persistence assertions depend on Lifespan's age and lifecycle state." },
    { "provider": "Sheltered-Expanded-Map-Sizes", "consumer": "BunkerRandomLocation", "scenario": "bunker-persistence", "reason": "Bunker persistence assertions depend on the Expanded Map Sizes world-position surface." },
    { "provider": "BunkerRandomLocation", "consumer": "ExpeditionFour", "scenario": "four-person-expedition", "reason": "The completion-backed expedition transaction consumes the Bunker route origin." },
    { "provider": "TradingAmount", "consumer": "Sheltered-Vanilla-Fixes", "scenario": "trading-amount", "reason": "The completion-backed trade transaction covers the shared Vanilla Fixes UI seam." },
    { "provider": "Sheltered-Vanilla-Fixes", "consumer": "TradingAmount", "scenario": "trading-amount", "reason": "The completion-backed trade transaction covers the shared Trading Amount UI seam." }
  ],
  "scenarios": [
    { "id": "four-person-expedition", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "four-person-expedition", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/FourPersonReleaseScenarios.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseExpeditionState.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs", "ShelteredAgentInterface/Core/UnityAgentUtil.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "trading-amount", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "trading-amount", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "better-ai-queue-persistence", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "better-ai-queue-persistence", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/AdditionalModReleaseScenarios.cs", "ShelteredAgentInterface/Core/AdditionalModReleaseFixture.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseExpeditionState.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "lifespan-persistence", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "lifespan-persistence", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/FamilyPersistenceReleaseScenarios.cs", "ShelteredAgentInterface/Core/FamilyPersistenceReleaseFixture.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "bunker-persistence", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "bunker-persistence", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/FamilyPersistenceReleaseScenarios.cs", "ShelteredAgentInterface/Core/FamilyPersistenceReleaseFixture.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "family-persistence", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "family-persistence", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/FamilyPersistenceReleaseScenarios.cs", "ShelteredAgentInterface/Core/FamilyPersistenceReleaseFixture.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseExpeditionState.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "deep-progression", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/progression", "fixture": null, "steps": [ { "scenario": "deep-progression", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/ProgressionReleaseFixture.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "systems-oxygen", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/progression", "fixture": null, "steps": [ { "scenario": "systems-oxygen", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/ProgressionReleaseFixture.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "systems-water", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/progression", "fixture": null, "steps": [ { "scenario": "systems-water", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/ProgressionReleaseFixture.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "vanilla-breach", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "vanilla-breach", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/VanillaFixesReleaseScenarios.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "vanilla-radio", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "vanilla-radio", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/VanillaFixesReleaseScenarios.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "vanilla-quest-weapons", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "vanilla-quest-weapons", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/VanillaFixesReleaseScenarios.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "vanilla-trading-slots", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "vanilla-trading-slots", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/VanillaFixesReleaseScenarios.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "vanilla-weapon-craft", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "vanilla-weapon-craft", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/VanillaFixesReleaseScenarios.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "vanilla-recycling", "category": "gameplay", "heavy": true, "fixturePath": "/release-scenario/interaction", "fixture": null, "steps": [ { "scenario": "vanilla-recycling", "argument": "confirm=true" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/InteractionReleaseFixture.cs", "ShelteredAgentInterface/Core/VanillaFixesReleaseScenarios.cs", "ShelteredAgentInterface/Core/ReleaseSaveSession.cs", "ShelteredAgentInterface/Core/ReleaseFixtureArguments.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "expanded-map-sizes", "category": "gameplay", "heavy": true, "fixturePath": "/release-fixture/additional", "fixture": "expanded-map-sizes", "steps": [ { "action": "status" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/AdditionalModReleaseFixture.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "display-fixes", "category": "gameplay", "heavy": true, "fixturePath": "/release-fixture/additional", "fixture": "sheltered-display-fixes", "steps": [ { "action": "status" } ], "harnessInputs": [ "ShelteredAgentInterface/Core/AdditionalModReleaseFixture.cs" ], "platforms": [ "Steam", "Epic" ] },
    { "id": "manager-platform-smoke", "category": "platform-smoke", "heavy": false, "fixturePath": "/state/health", "fixture": null, "steps": [ { "route": "/status" }, { "route": "/state/health" }, { "route": "/state/mods/apis" } ], "platforms": [ "Steam", "Epic" ] }
  ]
}
