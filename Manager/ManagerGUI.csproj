  <Target Name="PrepareCortexRuntimeLayout" BeforeTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(SmmCortexRootFullPath)') and '$(BuildCortexBundle)' != 'true'">
    <RemoveDir Directories="$(SmmCortexRootFullPath)" />
  </Target>
  <Target Name="BuildCortexRuntime" BeforeTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildCortexBundle)' == 'true'">
    <RemoveDir Condition="Exists('$(SmmCortexRootFullPath)')" Directories="$(SmmCortexRootFullPath)" />
    <Warning Condition="!Exists('$(CortexBundleProject)')" Text="Cortex bundle project was not found at '$(CortexBundleProject)'. SMM will build without the optional Cortex runtime bundle." />
    <MSBuild Condition="Exists('$(CortexBundleProject)')"
             Projects="$(CortexBundleProject)"
             Targets="BundleProfiles"
             Properties="Configuration=$(Configuration);Platform=AnyCPU;BundleProfiles=$(CortexBundleProfileId)"
             BuildInParallel="false" />
    <MakeDir Condition="Exists('$(CortexBundleProfileSourceRoot)')" Directories="$(SmmCortexRootFullPath)" />
    <ItemGroup Condition="Exists('$(CortexBundleDist)cortex.bundle.index.json')">
      <CortexBundleIndexFile Include="$(CortexBundleDist)cortex.bundle.index.json" />
    </ItemGroup>
    <ItemGroup Condition="Exists('$(CortexBundleProfileSourceRoot)')">
      <CortexBundleFiles Include="$(CortexBundleProfileSourceRoot)**\*" />
    </ItemGroup>
    <Copy Condition="Exists('$(CortexBundleDist)cortex.bundle.index.json')"
          SourceFiles="@(CortexBundleIndexFile)"
          DestinationFiles="@(CortexBundleIndexFile->'$(SmmCortexRootFullPath)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy Condition="Exists('$(CortexBundleProfileSourceRoot)')"
          SourceFiles="@(CortexBundleFiles)"
          DestinationFiles="@(CortexBundleFiles->'$(SmmCortexRootFullPath)$(CortexBundleProfileId)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="ValidatePackagedCortexRuntime" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildCortexBundle)' == 'true' and Exists('$(CortexBundleProject)')">
    <Error Condition="!Exists('$(SmmCortexRootFullPath)cortex.bundle.index.json')" Text="Packaged Cortex bundle index is missing at '$(SmmCortexRootFullPath)cortex.bundle.index.json'." />
    <Error Condition="!Exists('$(SmmCortexBundleProfileRootFullPath)manifest\cortex.bundle.manifest.json')" Text="Packaged Cortex bundle manifest is missing at '$(SmmCortexBundleProfileRootFullPath)manifest\cortex.bundle.manifest.json'." />
    <Error Condition="!Exists('$(SmmCortexBundleProfileRootFullPath)host\lib\Cortex.dll')" Text="Packaged Cortex Unity host runtime is missing at '$(SmmCortexBundleProfileRootFullPath)host\lib\Cortex.dll'." />
    <Error Condition="!Exists('$(SmmCortexBundleProfileRootFullPath)portable\lib\Cortex.Core.dll')" Text="Packaged Cortex portable runtime is missing at '$(SmmCortexBundleProfileRootFullPath)portable\lib\Cortex.Core.dll'." />
    <Error Condition="!Exists('$(SmmCortexBundleProfileRootFullPath)tooling\decompiler\Decompiler.exe')" Text="Packaged Cortex decompiler tool is missing at '$(SmmCortexBundleProfileRootFullPath)tooling\decompiler\Decompiler.exe'." />
    <Error Condition="!Exists('$(SmmCortexBundleProfileRootFullPath)tooling\roslyn\Cortex.Roslyn.Worker.exe')" Text="Packaged Cortex Roslyn worker is missing at '$(SmmCortexBundleProfileRootFullPath)tooling\roslyn\Cortex.Roslyn.Worker.exe'." />
    <Error Condition="!Exists('$(SmmCortexBundleProfileRootFullPath)plugins\Harmony\cortex.plugin.json')" Text="Packaged Cortex Harmony plugin manifest is missing at '$(SmmCortexBundleProfileRootFullPath)plugins\Harmony\cortex.plugin.json'." />
    <Error Condition="!Exists('$(SmmCortexBundleProfileRootFullPath)host\lib\Cortex.Host.Sheltered.dll')" Text="Packaged SMM Cortex host adapter is missing at '$(SmmCortexBundleProfileRootFullPath)host\lib\Cortex.Host.Sheltered.dll'." />
    <Error Condition="!Exists('$(SmmCortexBundleProfileRootFullPath)host\lib\Cortex.Platform.ModAPI.dll')" Text="Packaged SMM Cortex ModAPI bridge is missing at '$(SmmCortexBundleProfileRootFullPath)host\lib\Cortex.Platform.ModAPI.dll'." />
  </Target>
  <PropertyGroup>
    <PostBuildEvent>SET BASE=$(MSBuildProjectDirectory)\..\
SET CONFIG=$(Configuration)
SET SMM_DIR=%25BASE%25Dist\SMM
SET BIN_DIR=%25SMM_DIR%25\bin
SET MODS_DIR=%25BASE%25Dist\mods
SET HARMONY_DLL=%25BASE%25libs\0Harmony.dll

mkdir "%25SMM_DIR%25" 2&gt;nul
mkdir "%25BIN_DIR%25" 2&gt;nul
mkdir "%25MODS_DIR%25" 2&gt;nul

if exist "%25HARMONY_DLL%25" copy /y "%25HARMONY_DLL%25" "%25BIN_DIR%25\"

if exist "%25BASE%25libs\winhttp.dll" copy /y "%25BASE%25libs\winhttp.dll" "%25BASE%25Dist\"

if exist "%25BASE%25PluginConsole\bin\%25CONFIG%25\PluginConsole.dll" copy /y "%25BASE%25PluginConsole\bin\%25CONFIG%25\PluginConsole.dll" "%25MODS_DIR%25\PluginConsole\Assemblies\"
if exist "%25BASE%25PluginConsole\bin\%25CONFIG%25\PluginConsole.pdb" copy /y "%25BASE%25PluginConsole\bin\%25CONFIG%25\PluginConsole.pdb" "%25MODS_DIR%25\PluginConsole\Assemblies\"
if exist "%25BASE%25PluginDebugGUI\bin\%25CONFIG%25\PluginDebugGUI.dll" copy /y "%25BASE%25PluginDebugGUI\bin\%25CONFIG%25\PluginDebugGUI.dll" "%25MODS_DIR%25\PluginDebugGUI\Assemblies\"
if exist "%25BASE%25PluginInitializer\bin\%25CONFIG%25\PluginInitializer.dll" copy /y "%25BASE%25PluginInitializer\bin\%25CONFIG%25\PluginInitializer.dll" "%25MODS_DIR%25\PluginInitializer\Assemblies\"
</PostBuildEvent>
